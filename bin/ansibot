            h1 {{ font-size: 1.5rem; font-weight: 600; margin-bottom: 8px; }}
            .subtitle {{ color: #8b949e; font-size: 0.9rem; margin-bottom: 24px; }}
            table {{ width: 100%; border-collapse: collapse; font-size: 0.875rem; }}
            thead th {{ text-align: left; padding: 10px 12px; color: #8b949e; font-weight: 500; font-size: 0.75rem; text-transform: uppercase; border-bottom: 1px solid #30363d; }}
            tbody tr {{ border-bottom: 1px solid #21262d; }}
            tbody tr:hover {{ background: #161b22; }}
            td {{ padding: 12px; vertical-align: middle; }}
            .tool {{ color: #58a6ff; font-weight: 600; }}
            .pb {{ color: #c9d1d9; }}
            .mono {{ font-family: ui-monospace, monospace; font-size: 0.82rem; }}
            .desc {{ color: #8b949e; max-width: 420px; line-height: 1.35; }}
            .btn-run {{ background: #238636; color: #fff; border: none; padding: 5px 14px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer; }}
            .btn-run:hover {{ background: #2ea043; }}
            .empty {{ color: #8b949e; padding: 32px 12px; }}
        </style>
    </head>
    <body>
        <aside class="sidebar">
