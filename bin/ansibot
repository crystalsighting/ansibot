    </body>
    </html>
    """
    return HTMLResponse(content=html)


@mcp.custom_route("/logs", methods=["GET"])
async def logs_ui(request: Request) -> HTMLResponse:
    url = (
        f"{FORGEJO_URL}/api/v1/repos/{FORGEJO_OWNER}/{FORGEJO_REPO}"
        f"/actions/runs?page=1&limit={ANSIBOT_LIMIT}"
    )
    headers = {"Authorization": f"token {FORGEJO_TOKEN}", "Accept": "application/json"}
    playbook_to_name = {}
    for section in app_config.sections():
        if section not in ("server", "forgejo"):
            pb = app_config.get(section, "playbook", fallback="").strip()
            if pb:
                playbook_to_name[pb] = section

    rows = ""
    error_block = ""

    try:
        client = get_http_client()
        response = await client.get(url, headers=headers)
        if response.status_code == 200:
            data = response.json()
            if isinstance(data, dict):
                runs = data.get("workflow_runs", data.get("runs", []))
            elif isinstance(data, list):
                runs = data
            else:
                runs = []
            if not isinstance(runs, list):
                runs = []
            runs = runs[:ANSIBOT_LIMIT]

            if not runs:
                rows = '<tr><td colspan="6" class="empty">No recent runs found.</td></tr>'
            else:
                for run in runs:
                    if not isinstance(run, dict):
                        continue
                    db_id = run.get("id", "N/A")
                    run_index = (
                        run.get("index_in_repo")
                        or run.get("run_number")
                        or run.get("index")
                        or db_id
                    )
                    playbook = None
                    try:
                        payload_raw = run.get("event_payload") or ""
                        if payload_raw:
                            playbook = json.loads(payload_raw).get("inputs", {}).get("playbook")
                    except (json.JSONDecodeError, TypeError, AttributeError):
                        pass

                    tool_name = playbook_to_name.get(playbook) if playbook else None
                    name_cell = (
                        f'<span class="tool">{tool_name}</span>'
                        if tool_name
                        else '<span class="muted">—</span>'
                    )
                    playbook_cell = (
                        f'<span class="pb">{playbook}</span>'
                        if playbook
                        else '<span class="muted">—</span>'
                    )
                    status = run.get("status", "unknown")
                    if status in ["success", "completed"]:
                        status_class = "st-ok"
                    elif status in ["failure", "cancelled", "skipped", "error"]:
                        status_class = "st-fail"
                    else:
                        status_class = "st-pending"

                    created_at = run.get("created_at") or run.get("created") or ""
                    if created_at:
                        try:
                            dt = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
                            created_at = dt.strftime("%Y-%m-%d %H:%M")
                        except (ValueError, TypeError):
                            pass

                    log_link = run.get("html_url") or (
                        f"{FORGEJO_URL}/{FORGEJO_OWNER}/{FORGEJO_REPO}/actions/runs/{run_index}"
                    )
                    rows += f"""
                    <tr>
                        <td class="col-name">{name_cell}</td>
                        <td class="mono">{playbook_cell}</td>
                        <td><span class="badge {status_class}">{status}</span></td>
                        <td class="mono">#{run_index}</td>
                        <td class="mono muted">{created_at}</td>
                        <td><a href="{log_link}" target="_blank" class="btn-link">Logs →</a></td>
                    </tr>
                    """
        else:
            error_block = (
                f'<div class="error-box"><strong>API Error</strong> — '
                f"HTTP {response.status_code}<pre>{response.text}</pre></div>"
            )
    except (httpx.InvalidURL, httpx.RequestError, ValueError) as e:
        error_block = (
            f'<div class="error-box"><strong>URL / Connection Error</strong>'
            f"<pre>{str(e)}</pre></div>"
        )
    except Exception as e:
        error_block = (
            f'<div class="error-box"><strong>Unknown Error</strong>'
            f"<pre>{str(e)}</pre></div>"
        )

    # Always refresh every 10s while the logs tab is open
    poll_js = """
<script>
  setTimeout(function () { location.reload(); }, 10000);
</script>
"""

    html = f"""
    <!DOCTYPE html>
    <html>
    <head>
        <title>ANSIBOT — Logs</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <style>
            * {{ box-sizing: border-box; margin: 0; padding: 0; }}
            body {{ font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0d1117; color: #e6edf3; display: flex; min-height: 100vh; }}
            .sidebar {{ width: 220px; background: #161b22; border-right: 1px solid #30363d; padding: 24px 16px; position: fixed; top: 0; left: 0; bottom: 0; }}
            .logo {{ font-size: 1.25rem; font-weight: 700; color: #58a6ff; margin-bottom: 32px; }}
            .nav a {{ display: block; padding: 10px 12px; color: #8b949e; text-decoration: none; border-radius: 6px; font-size: 0.9rem; margin-bottom: 4px; }}
            .nav a:hover {{ background: #21262d; color: #e6edf3; }}
            .nav a.active {{ background: #21262d; color: #58a6ff; font-weight: 500; }}
            .main {{ margin-left: 220px; flex: 1; padding: 32px 40px; }}
            h1 {{ font-size: 1.5rem; font-weight: 600; margin-bottom: 8px; }}
            .subtitle {{ color: #8b949e; font-size: 0.9rem; margin-bottom: 24px; }}
            table {{ width: 100%; border-collapse: collapse; font-size: 0.875rem; }}
            thead th {{ text-align: left; padding: 10px 12px; color: #8b949e; font-weight: 500; font-size: 0.75rem; text-transform: uppercase; border-bottom: 1px solid #30363d; }}
            tbody tr {{ border-bottom: 1px solid #21262d; }}
            tbody tr:hover {{ background: #161b22; }}
            td {{ padding: 12px; vertical-align: middle; }}
            .tool {{ color: #58a6ff; font-weight: 600; }}
            .pb {{ color: #c9d1d9; }}
            .mono {{ font-family: ui-monospace, monospace; font-size: 0.82rem; }}
            .muted {{ color: #8b949e; }}
            .badge {{ display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }}
            .st-ok {{ background: rgba(46,160,67,0.15); color: #3fb950; }}
            .st-fail {{ background: rgba(248,81,73,0.15); color: #f85149; }}
            .st-pending {{ background: rgba(210,153,34,0.15); color: #d29922; }}
            .btn-link {{ color: #58a6ff; text-decoration: none; font-weight: 500; font-size: 0.85rem; }}
            .empty {{ color: #8b949e; padding: 32px 12px; }}
            .error-box {{ background: #161b22; border: 1px solid #f85149; border-radius: 8px; padding: 16px; margin-bottom: 20px; }}
            .error-box pre {{ margin-top: 8px; color: #8b949e; font-size: 0.8rem; white-space: pre-wrap; }}
        </style>
    </head>
    <body>
        <aside class="sidebar">
            <div class="logo">ANSIBOT</div>
            <nav class="nav">
                <a href="/">Playbooks</a>
                <a href="/logs" class="active">Execution Logs</a>
            </nav>
        </aside>
        <main class="main">
            <h1>Execution Logs</h1>
            <p class="subtitle">Recent Forgejo Actions runs (limit {ANSIBOT_LIMIT})</p>
            {error_block}
            <table>
                <thead>
                    <tr>
                        <th>MCP Tool</th><th>Playbook</th><th>Status</th>
                        <th>Run</th><th>Triggered</th><th></th>
                    </tr>
                </thead>
                <tbody>{rows}</tbody>
            </table>
        </main>
        {poll_js}
    </body>
    </html>
    """
    return HTMLResponse(content=html)


@mcp.custom_route("/run/{tool_name}", methods=["POST"])
async def trigger_playbook_web(request: Request) -> HTMLResponse:
    tool_name = request.path_params.get("tool_name")
    if (
        not tool_name
        or tool_name in ("server", "forgejo")
        or not app_config.has_section(tool_name)
    ):
        return HTMLResponse(
            "<h2>Error: Playbook target not found.</h2><a href='/'>Go back</a>",
            status_code=404,
        )
    result = await run_playbook(app_config.get(tool_name, "playbook"), None)
    html = f"""
    <!DOCTYPE html>
    <html>
    <head><title>Dispatch Result</title>
    <style>
        body {{ font-family: monospace; background: #121212; color: #e0e0e0; margin: 40px; }}
        .result-box {{ background: #1e1e1e; border-left: 4px solid #58a6ff; padding: 20px; margin-top: 20px; font-size: 1.1em; }}
        a {{ color: #58a6ff; text-decoration: none; margin-right: 15px; }}
    </style></head>
    <body>
        <h2>Dispatching: {tool_name}</h2>
        <div class="result-box">{result}</div>
        <div>
            <a href="/">&larr; Return to Dashboard</a>
            <a href="/logs">View Execution Logs &rarr;</a>
        </div>
    </body>
    </html>
    """
    return HTMLResponse(content=html)


